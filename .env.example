TELEGRAM_BOT_TOKEN=
# 0으로 둔 뒤 봇의 /whoami로 확인하고 실제 숫자로 바꾸세요.
OWNER_TELEGRAM_ID=0
PUBLIC_SIGNUP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# 자연어 레시피 구조화 전용 저비용 모델과 서버 측 하드 제한
OPENAI_RECIPE_MODEL=gpt-5.6-luna
OPENAI_MENU_MODEL=gpt-5.6-luna
RECIPE_AI_DAILY_LIMIT=10
RECIPE_AI_MONTHLY_LIMIT=100
RECIPE_AI_MAX_INPUT_CHARS=2000
RECIPE_AI_MAX_OUTPUT_TOKENS=800
RECIPE_MAX_INGREDIENTS=20
RECIPE_AI_COOLDOWN_SECONDS=10
# 외식 메뉴 검색은 공식 브랜드 출처만 허용하며 검색 도구 호출은 요청당 1회로 고정됩니다.
MENU_AI_DAILY_LIMIT=5
MENU_AI_MONTHLY_LIMIT=50
MENU_AI_GLOBAL_DAILY_LIMIT=20
MENU_AI_GLOBAL_MONTHLY_LIMIT=200
MENU_AI_MAX_QUERY_CHARS=80
MENU_AI_MAX_OUTPUT_TOKENS=900
MENU_AI_COOLDOWN_SECONDS=15
MENU_SEARCH_CACHE_DAYS=7

# 공공데이터포털의 "식품의약품안전처_식품영양성분DB정보" 활용신청 후 발급받은 키
MFDS_API_KEY=
MFDS_API_TIMEOUT_SECONDS=8

# 로컬 Python 실행은 SQLite, Docker Compose 실행은 자동으로 PostgreSQL을 사용합니다.
DATABASE_URL=sqlite+aiosqlite:///./data/calorie_bot.db
POSTGRES_PASSWORD=change-me

APP_TIMEZONE=Asia/Seoul
DATA_DIR=./data
LOG_LEVEL=INFO
# 기본값은 파일당 10 MiB, 이전 파일 10개 보관(현재 파일 포함 최대 약 110 MiB)입니다.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Docker에서 /data/logs와 연결할 호스트 경로입니다. 절대 경로도 사용할 수 있습니다.
CALORIE_LOG_DIR=./runtime/logs
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# 웹 수정 기능은 아래 Access 검증값을 모두 넣은 뒤에만 true로 바꾸세요.
DASHBOARD_WRITES_ENABLED=false
# 예: https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > 해당 앱 > Application Audience (AUD) Tag
CLOUDFLARE_ACCESS_AUD=
# Access 허용 정책에 등록한 소유자 이메일과 정확히 같아야 합니다.
CLOUDFLARE_ACCESS_ALLOWED_EMAIL=
OPENFOODFACTS_USER_AGENT=calorie-telegram-bot/0.1 (personal-use; contact=you@example.com)
