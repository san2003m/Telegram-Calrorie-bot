TELEGRAM_BOT_TOKEN=
# 0으로 둔 뒤 봇의 /whoami로 확인하고 실제 숫자로 바꾸세요.
OWNER_TELEGRAM_ID=0
PUBLIC_SIGNUP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# 로컬 Python 실행은 SQLite, Docker Compose 실행은 자동으로 PostgreSQL을 사용합니다.
DATABASE_URL=sqlite+aiosqlite:///./data/calorie_bot.db
POSTGRES_PASSWORD=change-me

APP_TIMEZONE=Asia/Seoul
DATA_DIR=./data
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
OPENFOODFACTS_USER_AGENT=calorie-telegram-bot/0.1 (personal-use; contact=you@example.com)
